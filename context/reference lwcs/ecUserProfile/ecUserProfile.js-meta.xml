<?xml version="1.0" encoding="UTF-8" ?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>EC User Profile</masterLabel>
    <description>Self-service profile card for the running user: view/edit their contact and language/locale/time-zone fields and change their password with live policy feedback.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property
                label="Hide Change Password Section"
                name="hidePasswordSection"
                type="Boolean"
                default="false"
            />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>